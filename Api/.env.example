# ==========================================
# Banco de dados
# ==========================================
# Credenciais padrão do Postgres provisionado pelo docker-compose.yml (`npm run db:up`).
# A porta do host é 5434 para conviver com um Postgres nativo em 5432.
# Em produção, use uma string de conexão real (Postgres gerenciado, Prisma Postgres, etc.).
DATABASE_URL="postgresql://petemdia:petemdia@localhost:5434/petemdia?schema=public"

# ==========================================
# Aplicação
# ==========================================
NODE_ENV="development"          # development | production | test
PORT=3000
# Nível mínimo de log do pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"

# ==========================================
# Autenticação / JWT
# ==========================================
# Segredo usado para assinar os access tokens JWT. OBRIGATÓRIO, mínimo de 32 caracteres.
# Gere um valor forte com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-forte-com-no-minimo-32-caracteres"

# Tempo de vida do access token, em segundos (padrão: 3600 = 1h).
JWT_ACCESS_EXPIRES_IN_SECONDS=3600

# Tempo de vida do refresh token, em dias (padrão: 7).
JWT_REFRESH_EXPIRES_IN_DAYS=7

# ==========================================
# CORS
# ==========================================
# Allowlist de origens permitidas, separadas por vírgula (sem barra no final).
# Vazio em desenvolvimento libera qualquer origem; vazio em produção bloqueia
# todas as requisições cross-origin.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# ==========================================
# Rate limiting (global, por IP)
# ==========================================
# Janela de contagem, em segundos (padrão: 60).
THROTTLE_TTL_SECONDS=60
# Máximo de requisições por janela (padrão: 100). O login e o cadastro têm
# limite próprio e mais restrito (5 por minuto).
THROTTLE_LIMIT=100
